# Copy to .env. Only the local Node server reads these values.
OPENAI_API_KEY=
# Use a model available to your project that supports Responses + Structured Outputs.
OPENAI_MODEL=gpt-6-astra
PORT=3000
# Relative paths are resolved from the repository root.
# SAVE_DB=data/campaigns.sqlite
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_OUTPUT_TOKENS=4000
